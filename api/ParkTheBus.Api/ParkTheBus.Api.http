@ParkTheBus.Api_HostAddress = http://localhost:5114
@sessionId = 11111111-1111-1111-1111-111111111111
@promptId = 1

GET {{ParkTheBus.Api_HostAddress}}/puzzles/today
Accept: application/json

###

POST {{ParkTheBus.Api_HostAddress}}/puzzles/today/prompts/{{promptId}}/start
Content-Type: application/json
X-Session-Id: {{sessionId}}

{
  "sessionId": "{{sessionId}}"
}

###

POST {{ParkTheBus.Api_HostAddress}}/puzzles/today/prompts/{{promptId}}/answer
Content-Type: application/json
X-Session-Id: {{sessionId}}

{
  "sessionId": "{{sessionId}}",
  "text": "example"
}

###
